 "texts": {
  "tip_curl_thumb_straighten": "Straighten your thumb out.",
  "tip_curl_thumb_fold": "Fold your thumb across your palm.",
  "tip_curl_index_straighten": "Straighten your index finger.",
  "tip_curl_index_fold": "Fold your index finger down.",
  "tip_curl_middle_straighten": "Straighten your middle finger.",
  "tip_curl_middle_fold": "Fold your middle finger down.",
  "tip_curl_ring_straighten": "Straighten your ring finger.",
  "tip_curl_ring_fold": "Fold your ring finger down.",
  "tip_curl_pinky_straighten": "Straighten your pinky.",
  "tip_curl_pinky_fold": "Fold your pinky down.",
  "tip_point_up": "Point your fingers straight up.",
  "tip_point_down": "Point your hand down.",
  "tip_point_side": "Turn your hand sideways, with your fingers pointing across.",
  "tip_point_forward": "Point your index finger forward, not straight down.",
  "tip_spread_together": "Press your index and middle fingers together.",
  "tip_spread_apart": "Spread your index and middle fingers apart.",
  "tip_cross_do": "Cross your middle finger over your index finger.",
  "tip_cross_undo": "Uncross your fingers.",
  "tip_thumbindex_touch": "Touch your thumb to your index finger.",
  "tip_thumbindex_away": "Move your thumb away from your index finger.",
  "tip_thumbmiddle_touch": "Rest your thumb against your middle finger.",
  "tip_thumbmiddle_away": "Move your thumb off your middle finger.",
  "tip_thumbout_in": "Bring your thumb in against your hand.",
  "tip_thumbout_out": "Stick your thumb out to the side.",
  "how_A": "Here's how to sign A. Make a fist, with your thumb resting against the side of your index finger.",
  "how_B": "Here's how to sign B. Hold your four fingers straight up and together, with your thumb folded across your palm.",
  "how_C": "Here's how to sign C. Curve your fingers and thumb into a C, like you're holding a cup.",
  "how_D": "Here's how to sign D. Point your index finger up, and curve your other fingers to touch your thumb.",
  "how_E": "Here's how to sign E. Bend all four fingertips down to rest on your thumb, tucked across your palm.",
  "how_F": "Here's how to sign F. Touch your index finger to your thumb in a circle, and hold your other three fingers up.",
  "how_G": "Here's how to sign G. Point your index finger sideways, with your thumb just above it. Fold the other fingers.",
  "how_H": "Here's how to sign H. Point your index and middle fingers sideways, side by side.",
  "how_I": "Here's how to sign I. Make a fist and raise your pinky straight up.",
  "how_K": "Here's how to sign K. Raise your index and middle fingers in a V, with your thumb resting between them.",
  "how_L": "Here's how to sign L. Point your index finger up and your thumb out to the side, making an L.",
  "how_M": "Here's how to sign M. Make a fist with your thumb tucked under your first three fingers.",
  "how_N": "Here's how to sign N. Make a fist with your thumb tucked under your first two fingers.",
  "how_O": "Here's how to sign O. Curve all your fingertips to touch your thumb, making an O.",
  "how_P": "Here's how to sign P. Make a K, then turn it so your hand points down.",
  "how_Q": "Here's how to sign Q. Make a G, then turn it so your finger and thumb point down.",
  "how_R": "Here's how to sign R. Cross your middle finger over your index finger, both pointing up.",
  "how_S": "Here's how to sign S. Make a fist with your thumb across the front of your fingers.",
  "how_T": "Here's how to sign T. Make a fist with your thumb tucked between your index and middle fingers.",
  "how_U": "Here's how to sign U. Hold your index and middle fingers straight up, pressed together.",
  "how_V": "Here's how to sign V. Hold your index and middle fingers up and apart, in a V.",
  "how_W": "Here's how to sign W. Hold your index, middle and ring fingers up and spread, with your thumb holding your pinky.",
  "how_X": "Here's how to sign X. Raise your index finger and bend it into a hook. Fold the other fingers.",
  "how_Y": "Here's how to sign Y. Stick out your thumb and your pinky, and fold the other three fingers."
 }
